# Copy this file to .env and fill in real values. Never commit .env.
# On GitHub Actions these come from repository secrets/variables instead (see README.md).

# ---- Telegram ----
# Bot token from @BotFather -> /mybots -> ShakhiraVIPBot -> API Token.
# The poster reads TELEGRAM_BOT_TOKEN; the subscription bot reads BOT_TOKEN. Same token value in both.
TELEGRAM_BOT_TOKEN=put_your_bot_token_here

# Public channel the poster publishes to: @username or numeric ID (-100...).
PUBLIC_CHANNEL=@yourshakhira

# ---- Subscription bot (shakhira_bot) ----
BOT_TOKEN=put_your_bot_token_here
# Numeric ID of the PRIVATE VIP channel (starts with -100). This is not a username.
VIP_CHANNEL_ID=
# Telegram username people can message for help (optional), e.g. @YourSupportAccount
SUPPORT_USERNAME=
# Prices in Telegram Stars. These match the current live bot; change only on purpose.
VIP_MONTHLY_PRICE=499
TRIAL_PRICE=49
TRIAL_DAYS=3
TRIAL_ONCE_PER_USER=true
DATABASE_PATH=data/shakhira_bot.db
EXPIRY_CHECK_SECONDS=300
# Who gets admin alerts (paid-but-no-access, removals, failed unbans, errors, failed backups).
# Your numeric Telegram user ID, or several separated by commas. Each must have pressed Start in the bot.
ADMIN_CHAT_IDS=
# Automatic database backups (SQLite online backup, checked, owner-only files).
BACKUP_DIR=data/backups
BACKUP_KEEP=14
# Hours between backups; 0 turns automatic backups off.
BACKUP_INTERVAL_HOURS=24

# ---- Cloudinary poster (poster) ----
# Cloudinary Console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tgpub
# auto (recommended), dynamic, or fixed
CLOUDINARY_FOLDER_MODE=auto
# Caption used when an asset has no "caption" in its Cloudinary metadata. Empty = no caption.
POST_CAPTION=
# oldest (default) or random
POST_SELECTION=oldest
# reuse (default): when no new media is left, repost the asset posted longest ago, after REUSE_COOLDOWN_DAYS.
# stop: never repeat a post. Posting-history tags are never removed in either mode.
POST_WHEN_EXHAUSTED=reuse
REUSE_COOLDOWN_DAYS=30
# Warn when fewer than this many unpublished assets are left after a post. 0 = never warn.
LOW_STOCK_THRESHOLD=5
# Optional: Telegram chat for poster alerts (your numeric user ID). Never the public channel.
ADMIN_CHAT_ID=
# UTC times of the daily schedule. Must match the cron lines in .github/workflows/post-to-channel.yml.
POST_SLOTS_UTC=16:30,23:30

# Optional rotating captions (separate with ||) and a footer for every caption.
POST_CAPTIONS=
POST_FOOTER=

# ---- Send-only worker and full-bot features (see DEPLOYMENT.md) ----
BOT_USERNAME=ShakhiraVIPBot
WORKER_INTERVAL_SECONDS=30
# Preview mode: scheduled items go ONLY to this private chat (your user ID). Remove to publish for real.
PREVIEW_CHAT_ID=
# Only if the public channel ALREADY has a linked discussion group (never created by the bot).
DISCUSSION_GROUP_ID=

# ---- Admin dashboard (python -m dashboard) ----
# python -m dashboard make-secret / python -m dashboard hash-password
DASHBOARD_SECRET=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Only for plain-http local testing; keep secure cookies behind HTTPS or an SSH tunnel.
DASHBOARD_INSECURE_COOKIES=false

LOG_LEVEL=INFO
