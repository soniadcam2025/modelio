# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather -> /mybots -> ShakhiraVIPBot -> API Token
BOT_TOKEN=put_your_bot_token_here

# Numeric ID of the PRIVATE VIP channel (starts with -100). See README.md.
VIP_CHANNEL_ID=

# Free public channel shown in the menu
PUBLIC_CHANNEL=@yourshakhira

# Telegram username people can message for help (optional), e.g. @YourSupportAccount
SUPPORT_USERNAME=

# Prices in Telegram Stars. These match the current live bot; change only on purpose.
VIP_MONTHLY_PRICE=499
TRIAL_PRICE=49
TRIAL_DAYS=3
TRIAL_ONCE_PER_USER=true

# Where subscriber records are stored
DATABASE_PATH=data/shakhira_bot.db

# How often (seconds) to check for ended trials
EXPIRY_CHECK_SECONDS=300

LOG_LEVEL=INFO
