# Copy this file to .env and fill in real values. Never commit .env.
# On GitHub Actions these come from repository secrets/variables instead (see README.md).

# ---- Telegram ----
# Bot token from @BotFather -> /mybots -> ShakhiraVIPBot -> API Token.
# The poster reads TELEGRAM_BOT_TOKEN; the subscription bot reads BOT_TOKEN. Same token value in both.
TELEGRAM_BOT_TOKEN=put_your_bot_token_here

# Public channel the poster publishes to: @username or numeric ID (-100...).
PUBLIC_CHANNEL=@yourshakhira

# ---- Subscription bot (shakhira_bot) ----
BOT_TOKEN=put_your_bot_token_here
# Numeric ID of the PRIVATE VIP channel (starts with -100). This is not a username.
VIP_CHANNEL_ID=
# Telegram username people can message for help (optional), e.g. @YourSupportAccount
SUPPORT_USERNAME=
# Prices in Telegram Stars. These match the current live bot; change only on purpose.
VIP_MONTHLY_PRICE=499
TRIAL_PRICE=49
TRIAL_DAYS=3
TRIAL_ONCE_PER_USER=true
DATABASE_PATH=data/shakhira_bot.db
EXPIRY_CHECK_SECONDS=300

# ---- Cloudinary poster (poster) ----
# Cloudinary Console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tgpub
# auto (recommended), dynamic, or fixed
CLOUDINARY_FOLDER_MODE=auto
# Caption used when an asset has no "caption" in its Cloudinary metadata. Empty = no caption.
POST_CAPTION=
# oldest (default) or random
POST_SELECTION=oldest
# stop (default): stop posting when everything was posted. restart: start a new round.
POST_WHEN_EXHAUSTED=stop

LOG_LEVEL=INFO
