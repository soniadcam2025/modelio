{
  "name": "shakhira-admin-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test --test-reporter=spec test/*.test.mjs",
    "test:supabase": "node build.mjs && TEST_DB=supabase node --test --test-concurrency=1 --test-reporter=spec test/*.test.mjs",
    "deploy:staging": "node build.mjs && wrangler deploy",
    "deploy:production": "node build.mjs && wrangler deploy -c wrangler.production.toml"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
